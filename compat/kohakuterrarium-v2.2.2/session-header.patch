diff --git a/src/kohakuterrarium-frontend/src/ext/SessionHeaderContributions.vue b/src/kohakuterrarium-frontend/src/ext/SessionHeaderContributions.vue
new file mode 100644
index 0000000000000000000000000000000000000000..a16affbbfde84646293b658b5534ea65a4614e21
--- /dev/null
+++ b/src/kohakuterrarium-frontend/src/ext/SessionHeaderContributions.vue
@@ -0,0 +1,45 @@
+<!-- Modified by the Kohaku Roleplay session-header compatibility patch for KohakuTerrarium v2.2.2. -->
+<template>
+  <div
+    v-if="headerPanels.length && scope.sessionId && scope.creatureId"
+    class="kt-session-header-contributions flex items-center gap-1.5 min-w-0 overflow-hidden"
+    data-test="session-header-contributions"
+  >
+    <ExtensionContribution
+      v-for="item in headerPanels"
+      :key="`${item.key}:${scope.sessionId}:${scope.creatureId}`"
+      :pkg="item.pkg"
+      :contribution="item.contribution"
+      surface="session-header"
+    />
+  </div>
+</template>
+
+<script setup>
+import { computed } from "vue"
+
+import ExtensionContribution from "@/ext/ExtensionContribution.vue"
+import { useOwnerScope } from "@/ext/ownerScope"
+import { contributionKey, extState } from "@/ext/state"
+
+const scope = useOwnerScope()
+
+const headerPanels = computed(() => {
+  const list = []
+  for (const pkg of extState.packages || []) {
+    if (!pkg || pkg.enabled === false || pkg.error || pkg.status === "disabled" || pkg.status === "incompatible")
+      continue
+    for (const contribution of pkg.contributes || []) {
+      if (contribution?.kind === "panel" && contribution.sessionHeader) {
+        list.push({
+          key: contributionKey(pkg.package, contribution.id),
+          pkg: pkg.package,
+          contribution,
+          order: Number.isFinite(contribution.order) ? contribution.order : 100,
+        })
+      }
+    }
+  }
+  return list.sort((a, b) => a.order - b.order)
+})
+</script>
